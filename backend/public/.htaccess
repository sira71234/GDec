<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Documents clients : jamais accessibles directement (même si d'anciens
    # fichiers subsistent dans public/storage sur l'hébergement).
    RewriteRule ^storage/(pieces_identite|devis)(/|$) - [F,L]

    # API Laravel.
    # - /api/... quand la racine réécrit directement vers public/index.php ;
    # - /public/api/... quand le site est consulté via /public/.
    # La condition !-f évite une boucle si la requête cible déjà index.php.
    RewriteCond %{REQUEST_URI} ^(/public)?/api
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    # Application React (build présent dans public/ ou à la racine du site).
    RewriteCond %{DOCUMENT_ROOT}/index.html -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/index.html -f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.html [L]

    # Repli Laravel (installation sans build React).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex index.html index.php
</IfModule>

# --- Sécurité : ne jamais servir les fichiers sensibles ---
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Les challenges ACME (.well-known) doivent rester accessibles pour le SSL.
<FilesMatch "^\.well-known$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)^(composer\.(json|lock)|artisan|phpunit\.xml(\.dist)?|README\.md|AGENTS\.md|.*\.(log|sql|bak|ini|sh|md))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Cache navigateur des assets (réduit les hits sur l'hébergement) ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|woff2?|css|js)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    # L'entrée HTML et les réponses JSON ne doivent jamais être réutilisées
    # depuis un cache : après un déploiement, chaque appareil doit charger le
    # nouveau build JS (sinon l'ancien écran de connexion reste affiché).
    <FilesMatch "\.(html|json)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>
